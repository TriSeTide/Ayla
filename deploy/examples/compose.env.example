# ============================================================================
# Ayla 部署 compose 变量模板（供 docker compose 读取）
# ----------------------------------------------------------------------------
# 实际文件：服务器 ~/Elysia/ayla-deploy/.env（权限 600，**不提交仓库**）。
# 复制本模板为 .env 后逐项替换占位符；密码建议 `openssl rand -hex 16` 生成。
# ============================================================================

# --- MySQL 8 ---
MYSQL_ROOT_PASSWORD=<openssl rand -hex 16>
MYSQL_DATABASE=ayla
MYSQL_USER=ayla
MYSQL_PASSWORD=<openssl rand -hex 16>

# --- Redis 7（requirepass）---
REDIS_PASSWORD=<openssl rand -hex 16>

# --- MinIO ---
MINIO_ROOT_USER=ayla_minio
MINIO_ROOT_PASSWORD=<openssl rand -hex 16>

# --- LiveKit（已退役 2026-09-12，仅 livekit 服务临时回滚时才需要）---
# LIVEKIT_KEY=ayla-livekit
# LIVEKIT_SECRET=<openssl rand -hex 24>
