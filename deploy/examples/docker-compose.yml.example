# ⚠️ 模板文件 → 线上 ~/Elysia/ayla-deploy/docker-compose.yml（部署时去掉 .example）
# 依赖同目录 .env（见 compose.env.example）。backend 镜像另需
# `docker build -f backend/Dockerfile -t ayla-backend:latest ~/Elysia/Elysium/Ayla/backend`。
#
# Ayla 生产部署编排（frp 服务器 ~/Elysia/ayla-deploy/）
# 架构（对齐 Ayla/docs/服务器半容器化部署方案.md，按用户指令 MySQL 容器化）：
#   - mysql/redis/minio/srs 走 bridge 网络，端口映射 127.0.0.1
#     （仅 frpc 本机可达，公网一律经 frp 穿透，不直接暴露）
#   - backend 用 network_mode: host：必须直连 Elysium 的 127.0.0.1:18000
#     （Elysium API 只监听 loopback，bridge 容器无法访问）；daphne 绑 127.0.0.1:8100
#   - nginx 用 network_mode: host：反代 backend 127.0.0.1:8100 / srs 127.0.0.1:8089 /
#     minio 127.0.0.1:9000；监听 127.0.0.1:80/443（frpc 本机可达）
#   - 前端静态文件挂载 ./web/dist
# 端口映射（127.0.0.1，frpc 对应穿透）：
#   mysql 3306 / redis 6379 / minio 9000+9001 / srs 1935+8089+1985 / nginx 80+443+8080+8443
# 退役：LiveKit 已于 2026-09-12 退役（语音改走 ws 音频中继，见 web/src/livekit/wsRelayRoom.ts）。
#   livekit 服务定义保留在 profile "retired" 下、不随 `up` 启动；容器 ayla-livekit 仍在
#   磁盘（`docker start ayla-livekit` 可临时回滚）。
services:
  mysql:
    image: mysql:8.0
    container_name: ayla-mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: ${MYSQL_DATABASE}
      MYSQL_USER: ${MYSQL_USER}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
    command: ["--character-set-server=utf8mb4", "--collation-server=utf8mb4_unicode_ci"]
    ports:
      - "127.0.0.1:3306:3306"
    volumes:
      - mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-p${MYSQL_ROOT_PASSWORD}"]
      interval: 5s
      timeout: 3s
      retries: 30

  redis:
    image: redis:7-alpine
    container_name: ayla-redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes", "--requirepass", "${REDIS_PASSWORD}"]
    ports:
      - "127.0.0.1:6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20

  minio:
    image: minio/minio:latest
    container_name: ayla-minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD}
    ports:
      - "127.0.0.1:9000:9000"   # S3 API
      - "127.0.0.1:9001:9001"   # 控制台（仅本机，不穿透公网）
    volumes:
      - minio_data:/data
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 5s
      timeout: 3s
      retries: 20

  # LiveKit SFU（已退役 2026-09-12）：语音改走 ws 音频中继（Opus over WebSocket over
  # TCP），frp 穿透下 UDP 源地址被改写导致 WebRTC/TURN 媒体面不可用，故整体退役。
  # profile "retired" 使其不随 `docker compose up` 启动；容器 ayla-livekit 仍保留在磁盘。
  # 如需临时回滚：docker compose --profile retired up -d livekit && docker start ayla-livekit
  livekit:
    profiles: ["retired"]
    image: livekit/livekit-server:v1.13
    container_name: ayla-livekit
    restart: unless-stopped
    command: --config /livekit.yaml
    environment:
      LIVEKIT_KEYS: "${LIVEKIT_KEY}: ${LIVEKIT_SECRET}"
    network_mode: host
    volumes:
      - ./livekit.yaml:/livekit.yaml:ro
      - livekit_data:/livekit
      - ./nginx/certs:/usr/local/livekit/certs:ro
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://localhost:7880/"]
      interval: 10s
      timeout: 3s
      retries: 12

  # SRS 流媒体：RTMP 1935 由 frpc 穿透（OBS 推流）；
  # HTTPS 8089 播放（HLS/FLV）走 nginx 反代 /live/（https://frp.volx.top/live）。
  srs:
    image: ossrs/srs:5
    container_name: ayla-srs
    restart: unless-stopped
    ports:
      - "127.0.0.1:1935:1935"       # RTMP 推流（frpc 穿透）
      - "127.0.0.1:8089:8089"       # HTTPS-FLV/HLS 播放（nginx 反代）
      - "127.0.0.1:1985:1985"       # HTTP API（backend 内部查询）
    volumes:
      - ./srs.conf:/usr/local/srs/conf/docker.conf:ro
      - ./nginx/certs:/usr/local/srs/conf/cert:ro
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/127.0.0.1/1985'"]
      interval: 10s
      timeout: 3s
      retries: 12

  # Ayla Django 后端：host 网络（连 Elysium 127.0.0.1:18000），daphne 绑 127.0.0.1:8100。
  # 镜像手动构建：docker build -f backend/Dockerfile -t ayla-backend:latest ../Elysium/Ayla/backend
  backend:
    image: ayla-backend:latest
    container_name: ayla-backend
    restart: unless-stopped
    network_mode: host
    env_file:
      - ./backend/.env
    volumes:
      - backend_runtime:/app/runtime
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
      minio:
        condition: service_healthy
      srs:
        condition: service_healthy

  # Nginx：host 网络（反代 backend 127.0.0.1:8100 / srs 127.0.0.1:8089 / minio 127.0.0.1:9000），
  # 监听 127.0.0.1:80/443，仅 frpc 可达。
  nginx:
    image: nginx:1.27-alpine
    container_name: ayla-nginx
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./nginx/certs:/etc/nginx/certs:ro
      - ./web/dist:/usr/share/nginx/html:ro
    depends_on:
      - backend

volumes:
  mysql_data:
  redis_data:
  minio_data:
  livekit_data:   # 退役保留：供 livekit 容器临时回滚用，勿删
  backend_runtime:
