# ============================================================================
# Ayla 后端环境变量模板（生产：host 网络部署）
# ----------------------------------------------------------------------------
# 实际文件：服务器 ~/Elysia/ayla-deploy/backend/.env（**不提交仓库**）。
# backend 容器 network_mode: host —— 所有依赖走 127.0.0.1 宿主机映射端口，
# Elysium API 直连 127.0.0.1:18000（Elysium 只监听 loopback）。
# ============================================================================

DEBUG=false
SECRET_KEY=<openssl rand -hex 32>
ALLOWED_HOSTS=*

# --- 数据库：MySQL 8（compose mysql 容器，映射 127.0.0.1:3306）---
DB_ENGINE=django.db.backends.mysql
DB_NAME=ayla
DB_USER=ayla
DB_PASSWORD=<与 compose.env 的 MYSQL_PASSWORD 一致>
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_OPTIONS=charset=utf8mb4

# --- Redis（channel layer + 缓存 + presence）---
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- 聊天 ---
MESSAGE_RECALL_SECONDS=120

# --- 爱莉桥接（服务器本机 Elysium，18000 只监听 127.0.0.1）---
ELYSIA_BASE_URL=http://127.0.0.1:18000
ELYSIA_CREDENTIAL_FILE=/app/runtime/elysia_credential.json
ELYSIA_SSE_RECONNECT_SECONDS=3.0
ELYSIA_SSE_EVENT_TYPES=chat.message
ELYSIA_BRIDGE_INLINE=true

# --- 其他 ---
TIME_ZONE=Asia/Shanghai
LOG_LEVEL=INFO

# --- 语音 ---
# LiveKit 已于 2026-09-12 退役（UDP 媒体面被 frp 改写源地址，WebRTC/TURN 不可用）。
# 现网语音 = ws 音频中继（Opus over WebSocket over TCP），无需服务端媒体配置。
# 下列变量仅 livekit 服务临时回滚时才需要，正常部署请勿设置：
# LIVEKIT_API_KEY=ayla-livekit
# LIVEKIT_API_SECRET=<openssl rand -hex 24>
# LIVEKIT_WS_URL=wss://ayla.trise.top/livekit
# LIVEKIT_TOKEN_TTL_SECONDS=600
VOICE_OBSERVER_ENABLED=true

# --- 直播：SRS ---
# PLAY：nginx 独立拉流入口 8443 -> SRS HTTPS 8089，公网 live.trise.top:7882
# RTMP：推流走朋友 frp 穿透 live.trise.top:1935
# API ：SRS HTTP API（backend 内部查询，127.0.0.1:1985）
SRS_API_URL=http://127.0.0.1:1985
SRS_RTMP_URL=rtmp://live.trise.top:1935/live
SRS_PLAY_URL=https://live.trise.top:7882/live
SRS_QUERY_TIMEOUT=2.0

# --- 媒体：MinIO（compose minio 容器，映射 127.0.0.1:9000）---
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=<与 compose.env 的 MINIO_ROOT_USER 一致>
S3_SECRET_KEY=<与 compose.env 的 MINIO_ROOT_PASSWORD 一致>
S3_BUCKET=elysia-media
S3_REGION=us-east-1
S3_PUBLIC=false
S3_STORAGE_BACKEND=s3
MEDIA_TMP_DIR=/app/runtime/media_tmp
