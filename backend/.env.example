# Elysia 后端环境变量模板。
# 复制为 .env 后按需填写。生产环境必须显式提供 SECRET_KEY / 数据库 / Redis。
# 严禁把真实密钥提交到仓库。

# 基础
DEBUG=true
SECRET_KEY=dev-only-insecure-secret-key-change-me
ALLOWED_HOSTS=*

# 数据库：本地开发默认 SQLite；生产切 MySQL 8
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=./db.sqlite3
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=elysia
# DB_USER=elysia
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Redis（channel layer + 缓存 + presence）
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# 其他
TIME_ZONE=Asia/Shanghai
LOG_LEVEL=INFO
