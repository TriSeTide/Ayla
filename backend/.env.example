# Elysia 后端环境变量模板。
# 复制为 .env 后按需填写。生产环境必须显式提供 SECRET_KEY / 数据库 / Redis。
# 严禁把真实密钥提交到仓库。

# 基础
DEBUG=true
SECRET_KEY=dev-only-insecure-secret-key-change-me
ALLOWED_HOSTS=*

# 数据库：本地开发默认 SQLite；生产切 MySQL 8
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=./db.sqlite3
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=elysia
# DB_USER=elysia
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Redis（channel layer + 缓存 + presence）
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# 聊天
MESSAGE_RECALL_SECONDS=120

# 爱莉桥接（M4-4）
# ELYSIA_BASE_URL：阶段三 Elysium API 根地址，如 http://127.0.0.1:8000
ELYSIA_BASE_URL=
# service credential 一次性 secret 落盘路径（Git 忽略，不提交；重启用它重换 session）
ELYSIA_CREDENTIAL_FILE=./runtime/elysia_credential.json
# SSE 断线重连有界退避初始间隔（秒）
ELYSIA_SSE_RECONNECT_SECONDS=3.0
# SSE 订阅事件类型（前缀过滤，取 chat.message.*）
ELYSIA_SSE_EVENT_TYPES=chat.message

# 媒体对象存储（M4-3，MinIO/S3 兼容；本地开发用 MinIO）
# 后端选择：s3=真实 MinIO/S3（默认）；fake=内存 FakeStorage（仅测试用，settings_test 强制 fake）
S3_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=elysia-media
S3_REGION=us-east-1
# 是否对对象加 public-read ACL（默认 false：私密媒体禁止进共享缓存）
# S3_PUBLIC=false

# 媒体上传限制（M4-3）：分类型大小上限（字节）；临时会话 TTL（秒）；缩略图最大边长
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VOICE_BYTES=31457280
MEDIA_MAX_FILE_BYTES=52428800
MEDIA_MAX_EMOJI_BYTES=5242880
MEDIA_TMP_TTL_SECONDS=600
MEDIA_THUMB_MAX=320

# 语音频道（M4-5）
# LiveKit SFU（自托管 LiveKit Server，见 docker-compose.yml livekit 服务）
# API key/secret 由 LiveKit Server 生成，走本机配置，严禁提交仓库
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 前端连接 LiveKit 的 WS 地址（与 docker-compose livekit 的 7880 端口对应）
LIVEKIT_WS_URL=ws://127.0.0.1:7880
# 访问 token TTL（秒），前端在过期前重签
LIVEKIT_TOKEN_TTL_SECONDS=600
# presence 心跳超时（秒）：超过未心跳的成员被标记离开
VOICE_MEMBER_TIMEOUT_SECONDS=120

# 直播（M4-6，SRS 流媒体服务器，见 docker-compose.yml srs 服务）
# SRS HTTP API 根（状态查询 /api/v1/streams、健康检查 /api/v1/versions）
SRS_API_URL=http://127.0.0.1:1985
# RTMP 推流地址前缀（stream_key 拼在其后，仅 owner 可见）
SRS_RTMP_URL=rtmp://127.0.0.1:1935/live
# HTTP-FLV/HLS 播放地址前缀（stream_key 拼在其后）
SRS_PLAY_URL=http://127.0.0.1:8080/live
# SRS 状态查询超时（秒）
SRS_QUERY_TIMEOUT=2.0
# 新进直播间历史弹幕条数（默认 50）
LIVE_DANMAKU_HISTORY_LIMIT=50

# 其他
TIME_ZONE=Asia/Shanghai
LOG_LEVEL=INFO
