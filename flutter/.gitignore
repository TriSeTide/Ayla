# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 第三方本地 fork 的构建产物（CMake .cxx / Gradle 缓存等）
**/.cxx/
**/.gradle/
**/CMakeFiles/
**/*.o
**/*.a
**/*.so
# 第三方 fork 的 Gradle 本地工程目录（`android/build` 只含 reports/problems，
# 是 AGP 的临时诊断产物；根 .gitignore 的 `/build/` 只锚定仓库根，
# `dist/` 也不覆盖这里 ⇒ 曾长期以未跟踪状态挂在 `git status` 里）。
**/third_party/**/android/build/
# Widget Preview related
.widget_preview/

# Dart/Flutter DevTools 扩展启用状态（本机按用户独立配置，不入库）。
# 官方说明：提交进版本控制 ⇒ 配置对全项目生效；加入 .gitignore ⇒ 按用户独立。
# https://docs.flutter.dev/tools/devtools/extensions#configure-extension-enablement-states
devtools_options.yaml
