{
 "READ_ME_FIRST": {
  "unitsConvention": {
   "viewport": "浏览器视口宽（window.innerWidth）。生产里它与列宽之间还隔着侧栏与 scroll padding，因此**不能**直接拿它当布局判据。",
   "rowInner": "【核心量】.msg-row 的 **content box** 宽 = rowW - 行自身 padding(0 var(--sp-1)) 合计 8。**已扣除**：桌面侧栏(0/356/380) + .message-scroll padding(宽屏 sp6×2=48，窄屏 sp4+sp3=24) + .message-column 居中留白。",
   "columnW": ".message-column 的 border box 宽（= 容器查询的查询对象）。因为 .message-column 自身 padding 为 0，所以 columnW = rowInner + 8，恒等。",
   "halo": ".msg-sender-halo 宽（= 37：avatar 32 核 + 2×2.5 光环）。已撤回/系统消息行为 null 语义（无头像）。",
   "gap": ".msg-row 的 column-gap（= 8 = --sp-2），行内出现 2 次（头像↔body↔actions）。",
   "actionsSlot": ".msg-actions 的固定槽位宽，与该行当前有几键无关。",
   "bubble": "气泡 .bubble 的 getBoundingClientRect().width。"
  },
  "reserve": {
   "valuePx": 53,
   "formula": "reserve = halo(37) + 2 × gap(8) = 53",
   "explicitlyExcludes": "**不含** .message-scroll padding，**不含** .msg-row 自身的 padding(8)——因为 max-width 的百分比基准就是 .msg-row 的 content box。",
   "warning": "把 scroll padding 或行 padding 混进 reserve 是本任务已经发生过的一次真实错误，不要再混。"
  },
  "bubbleCapFormula": {
   "rowsWithToolbar": "min(75%, calc(100% - 53px - var(--msg-actions-slot)))",
   "rowsWithToolbarNarrowLE768": "min(84%, calc(100% - 53px - var(--msg-actions-slot)))",
   "rowsWithoutToolbar": "75% / 84%（不扣，:has(> .msg-actions) 门控；已撤回与系统消息属此类）",
   "percentBase": "100% = .msg-row 的 content box（= rowInner）"
  },
  "slotValues": {
   "text": {
    "px": 156,
    "breakdown": "收藏 32 + gap 4 + 引用 58 + gap 4 + 撤回 58"
   },
   "icon": {
    "px": 78,
    "breakdown": "收藏 26 + gap 4 + 方键 22 + gap 4 + 方键 22",
    "squareButton": "22×22，图标 16 居中（实测左右各 5px）"
   }
  },
  "modeSwitch": {
   "implementation": "纯 CSS 容器查询：.message-column { container-type: inline-size; container-name: msg-column } + @container msg-column (max-width: 844px)",
   "comparesAgainst": "columnW（不是 rowInner、更不是 viewport）",
   "thresholdColumnW": 844,
   "equivalentRowInner": 836,
   "rule": "columnW ≤ 844（rowInner ≤ 836）⇒ 图标档；columnW ≥ 845（rowInner ≥ 837）⇒ 文字档",
   "measuredBoundary": {
    "columnW": [
     843,
     844,
     845
    ],
    "rowInner": [
     835,
     836,
     837
    ],
    "mode": [
     "icon",
     "icon",
     "text"
    ]
   },
   "rationale": "文字档「不吃掉气泡」⇔ rowInner − reserve − slot ≥ 0.75 × rowInner ⇔ 0.25 × rowInner ≥ 53 + 156 = 209 ⇔ rowInner ≥ 836。",
   "whyNotViewport": "同一个 vw 下列宽差 356px 以上（私聊侧栏 356 / 群聊侧栏 380 / 窄屏 0）。例：vw=1024 带私聊侧栏时 rowInner 仅 612（图标档），无侧栏时 952（文字档）。按 vw 判会在 1024 档误判。",
   "crossImplNote": "Flutter 侧按 LayoutBuilder 的 c.maxWidth - 2×sp1 得 rowInner 判档，与本文件的 columnW 判据在边界上等价（差 8px = 行 padding）。"
  },
  "sectionsGuide": {
   "chromeMessages": "【主口径】宽屏私聊/消息中心真实外壳（.wide-messages-sidebar 356 = 332 宽 + gutter 12×2）。Flutter 侧对账请读这一节。",
   "chromeGroup": "宽屏群聊真实外壳（ServerRail 96 + ChannelSidebar 284 = 380）。",
   "noChrome": "无侧栏裸列（历史探针口径）。**只有 ≤768 窄屏与生产一致**（窄屏侧栏不渲染）；≥769 这一节不代表生产，仅供回归对比。"
  },
  "scenarios": {
   "self3key": "自己 + 3 键工具栏（收藏/引用/撤回）+ 长文本",
   "self2key": "自己 + 2 键（撤回键 120s 后消失）+ 长文本",
   "self3keyPending": "自己 + 3 键 + 上传中（.msg-send-state，absolute 不占布局宽）+ 短文本",
