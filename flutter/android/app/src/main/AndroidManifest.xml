<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- PoC 阶段：本地开发需明文 HTTP 访问 SRS(8080)/后端(8100)/WS；正式版应收敛为网络安全配置 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 应用内更新：下载 APK 后需要切到系统安装器（Android 8+ 还需用户授予
         「安装未知来源应用」权限；不授予时客户端会退化为打开下载页）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- 后台下载保活（flutter_foreground_task）：聊天媒体 7 天就在云端过期，
         用户要求「app 后台运行时也保持下载」。dataSync 类型的前台服务在
         Android 8+ 常驻通知栏，Android 14+ 必须同时声明 FOREGROUND_SERVICE_DATA_SYNC。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 语音/直播会话「脱离应用」后的**系统层悬浮球**（悬浮球=task-5）。
         SYSTEM_ALERT_WINDOW 是特殊权限：没有运行时弹窗，只能跳
         Settings.ACTION_MANAGE_OVERLAY_PERMISSION 让用户自己打开。
         未授权时原生侧返回 "permissionRequired"，Dart 侧弹明确引导（不静默失败）。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- 悬浮球需要前台服务把进程钉住（叠加层随进程消失）。
         用 mediaPlayback 而不是 dataSync：现有下载服务的 dataSync 在 Android 15 有
         6 小时/24 小时上限，且语义不同（语音/直播会话本身就是媒体播放）。
         Android 14+ 必须同时声明这条配套权限，否则 startForeground 抛
         MissingForegroundServiceTypeException。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- 「记住密码 / 自动登录」的凭据存在 Android KeyStore（flutter_secure_storage）。
         插件 README 明确要求关闭自动备份：Google Drive 备份恢复后只带回加密密文、
         不回带 KeyStore 里的密钥 ⇒ 读取时抛
         `java.security.InvalidKeyException: Failed to unwrap key`。
         关闭备份只影响"换机自动恢复"，App 内数据不受影响。 -->
    <application
        android:label="Ayla"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">
        <!-- ⚠️ 不要加回 android:supportsPictureInPicture：1.0.40 已彻底移除系统 PiP。
             用户明确要求「彻底移除那个手机端系统 PiP（缩小整个 App）」。
             直播「脱离应用」走 Flutter 自绘的独立小窗，不是系统画中画。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 应用内更新：把 cacheDir 下已校验的 APK 以 content:// 交给系统安装器。
             authority = ${applicationId}.fileprovider（与 MainActivity.kt 一致）。
             exported=false + grantUriPermissions 只授予读权限。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 后台下载保活：flutter_foreground_task 的前台服务（插件 README 要求
             名字一字不改）。dataSync 对应「后台同步下载」语义。 -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- 语音/直播会话「脱离应用」悬浮球的保活服务（悬浮球=task-5）。
             mediaPlayback 是会话本身的语义；exported=false：只有本应用能启停。 -->
        <service
            android:name=".AylaFloatingBallService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
